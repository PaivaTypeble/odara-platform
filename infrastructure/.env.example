# ODARA Platform Environment Variables

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=odara
POSTGRES_PASSWORD=odara_dev_password
POSTGRES_DB=odara

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=odara
RABBITMQ_PASSWORD=odara_dev_password

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=odara
MINIO_SECRET_KEY=odara_dev_password
MINIO_BUCKET=odara-documents

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=odara
KEYCLOAK_CLIENT_ID=odara-web

# JWT
JWT_SECRET=ODARA-SUPER-SECRET-KEY-CHANGE-IN-PRODUCTION-MIN-32-CHARS
JWT_ISSUER=OdaraApi
JWT_AUDIENCE=OdaraWeb

# Application
APP_ENV=development
APP_PORT=5000
WEB_PORT=3000

# Email (configure for production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
