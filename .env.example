# ==========================================
# ODARA Platform - Environment Configuration
# ==========================================

# PostgreSQL
POSTGRES_USER=odara
POSTGRES_PASSWORD=odara_dev_password
POSTGRES_DB=odara

# API (.NET)
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Database=odara;Username=odara;Password=odara_dev_password
Jwt__Key=ODARA-SUPER-SECRET-KEY-CHANGE-IN-PRODUCTION-MIN-32-CHARS
Jwt__Issuer=OdaraApi
Jwt__Audience=OdaraWeb

# Keycloak
Keycloak__Authority=http://localhost:8080/realms/odara

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://odara:odara_dev_password@localhost:5672

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=odara
MINIO_SECRET_KEY=odara_dev_password
